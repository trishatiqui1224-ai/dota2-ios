# Raw Unity Assets are already baked into build_ios/Data; track Scripts, Shaders, Scenes, and link.xml
unity_ios_project/ExportedProject/Assets/*
!unity_ios_project/ExportedProject/Assets/Scripts/
!unity_ios_project/ExportedProject/Assets/Shader/
!unity_ios_project/ExportedProject/Assets/Scenes/
!unity_ios_project/ExportedProject/Assets/Settings/
